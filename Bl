// ---- RENDER ----
function el(tag, cls, text) {
  var n = document.createElement(tag);
  if (cls) n.className = cls;
  if (text != null) n.textContent = text;
  return n;
}

function renderChat() {
  var box = document.getElementById("chat-body");
  var head = el("div", "chat-head");
  head.appendChild(el("div", "chat-avatar", "MS"));
  var meta = el("div", "");
  meta.appendChild(el("div", "chat-title", DATA.chat.name));
  meta.appendChild(el("div", "chat-sub", DATA.chat.members));
  head.appendChild(meta);
  box.appendChild(head);
  DATA.chat.messages.forEach(function (m) {
    var mine = m.from === "You";
    var b = el("div", "msg" + (mine ? " r" : ""));
    if (!mine) b.appendChild(el("span", "who", m.from));
    b.appendChild(el("span", "", m.text));
    if (m.rx) {
      var rx = el("span", "rx", "");
      m.rx.forEach(function (r) { rx.appendChild(el("span", "", r[0] + " " + r[1])); });
      b.appendChild(rx);
    }
    b.appendChild(el("span", "time", m.t));
    box.appendChild(b);
  });
  var bar = el("div", "compose");
  bar.appendChild(el("span", "draft", DATA.chat.draft));
  bar.appendChild(el("span", "send", ""));
  box.appendChild(bar);
}

function renderFeed() {
  var f = DATA.feed;
  document.getElementById("ig-handle").textContent = f.handle;
  document.getElementById("ig-initials").textContent = f.initials;
  document.getElementById("ig-name").textContent = f.name;
  var stats = document.getElementById("ig-stats");
  f.counts.forEach(function (c) {
    var s = el("div", "");
    s.appendChild(el("b", "", c[1]));
    s.appendChild(document.createTextNode(c[0]));
    stats.appendChild(s);
  });
  var grid = document.getElementById("ig-grid");
  f.posts.forEach(function (p, i) {
    var t = el("button", "ig-tile");
    t.setAttribute("data-act", "post");
    t.setAttribute("data-i", String(i));
    t.setAttribute("aria-label", "Open post: " + p.caption);
    var img = el("img", "");
    img.src = p.img;
    img.alt = "";
    img.loading = "lazy";
    t.appendChild(img);
    grid.appendChild(t);
  });
  showPost(0);
}

