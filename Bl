function showPoem(i) {
  var e = DATA.essay;
  poemIx = Math.max(0, Math.min(e.poems.length - 1, i));
  var p = e.poems[poemIx];
  var page = document.getElementById("poem-page");
  page.textContent = "";
  page.appendChild(el("div", "folio", "Poem " + ROMAN[poemIx] + " of " + ROMAN[e.poems.length - 1]));
  page.appendChild(el("h2", "ptitle", p.title));
  page.appendChild(el("div", "prule", ""));
  p.stanzas.forEach(function (lines, si) {
    if (si > 0) {
      var sep = el("div", "sep", "");
      sep.textContent = "⁂";
      page.appendChild(sep);
    }
    var text = lines.join("\n");
    var s = el("p", "stanza");
    if (si === 0) {
      s.appendChild(el("span", "dc", text.charAt(0)));
      s.appendChild(document.createTextNode(text.slice(1)));
    } else {
      s.textContent = text;
    }
    page.appendChild(s);
  });
  var pager = document.querySelectorAll(".pager button");
  for (var k = 0; k < pager.length; k++) {
    pager[k].setAttribute("aria-selected", k === poemIx ? "true" : "false");
  }
  page.classList.remove("turn");
  void page.offsetWidth;
  page.classList.add("turn");
}

// Email client
var mailFolder = "inbox";
var mailIx = 0;
function mailItems() { return DATA.mail.folders[mailFolder].items; }

function emailHeader(m) {
  var h = el("div", "hdr");
  var av = el("span", "av", m.initials);
  av.style.background = m.color;
  h.appendChild(av);
  var who = el("div", "");
  who.appendChild(el("div", "who", m.from + " <" + m.addr + ">"));
  var meta = el("div", "meta");
  meta.appendChild(document.createTextNode("To: " + m.to));
  meta.appendChild(document.createElement("br"));
  if (m.cc) {
    meta.appendChild(document.createTextNode("Cc: " + m.cc));
    meta.appendChild(document.createElement("br"));
  }
  meta.appendChild(document.createTextNode((m.draft ? "Status: " : "Sent: ") + m.sent));
  who.appendChild(meta);
  h.appendChild(who);
  return h;
}
function emailBody(m) {
  var frag = document.createDocumentFragment();
  frag.appendChild(emailHeader(m));
  m.body.forEach(function (para) { frag.appendChild(el("p", "", para)); });
  return frag;
}

function renderFolders() {
  var box = document.getElementById("ol-folders");
  box.textContent = "";
  DATA.mail.order.forEach(function (key) {
    var f = DATA.mail.folders[key];
    var b = el("button", "ol-folder");
    b.setAttribute("data-act", "folder");
    b.setAttribute("data-f", key);
    b.setAttribute("aria-pressed", key === mailFolder ? "true" : "false");
    b.appendChild(document.createTextNode(f.label));
    var unread = f.items.filter(function (m) { return m.unread; }).length;
    if (unread) b.appendChild(el("span", "ct", String(unread)));
    box.appendChild(b);
  });
}

function renderList() {
  var list = document.getElementById("mail-list");
  list.textContent = "";
  var items = mailItems();
  if (!items.length) {
    list.appendChild(el("li", "ol-empty", "Nothing here."));
    return;
  }
  items.forEach(function (m, i) {
    var li = el("li", "");
    var b = el("button", "ol-item" + (m.unread ? " unread" : ""));
    b.setAttribute("data-act", "mail");
    b.setAttribute("data-i", String(i));
    b.setAttribute("aria-selected", i === mailIx ? "true" : "false");
    var av = el("span", "av", m.initials);
    av.style.background = m.color;
    b.appendChild(av);
    var col = el("div", "");
    var r1 = el("div", "row1");
    var outgoing = m.draft || mailFolder === "sent";
    var fromWrap = el("span", "from");
    if (m.unread) fromWrap.appendChild(el("span", "dot", ""));
    fromWrap.appendChild(document.createTextNode(outgoing ? "To: " + m.to.split(" <")[0] : m.from));
    r1.appendChild(fromWrap);
    r1.appendChild(el("span", m.draft ? "date draft-tag" : "date", m.short));
    col.appendChild(r1);
    col.appendChild(el("div", "subj", m.subject));
    col.appendChild(el("div", "prev", m.body[0]));
    b.appendChild(col);
    li.appendChild(b);
    list.appendChild(li);
  });
}

function showFolder(key) {
  mailFolder = key;
  mailIx = 0;
  renderFolders();
  renderList();
  showMail(0);
}

function showMail(i) {
  var items = mailItems();
  var read = document.getElementById("mail-read");
  read.textContent = "";
  if (!items.length) {
    mailIx = 0;
    read.appendChild(el("p", "ol-empty", "This folder is empty."));
    return;
  }
  mailIx = Math.max(0, Math.min(items.length - 1, i));
  var m = items[mailIx];
  var rows = document.querySelectorAll(".ol-item");
  for (var k = 0; k < rows.length; k++) {
    rows[k].setAttribute("aria-selected", k === mailIx ? "true" : "false");
  }
  read.appendChild(el("h3", "subject", m.subject));
  read.appendChild(emailBody(m));
  if (m.attachments.length) {
    var att = el("div", "ol-att");
    m.attachments.forEach(function (a) { att.appendChild(el("span", "", a)); });
    read.appendChild(att);
  }
  if (m.earlier) {
    var prev = DATA.mail.folders[m.earlier.folder].items[m.earlier.index];
    var det = el("details", "earlier");
    det.appendChild(el("summary", "", "Show earlier message from " + prev.from));
    var q = el("div", "quoted");
    q.appendChild(emailBody(prev));
    if (prev.attachments.length) {
      var patt = el("div", "ol-att");
      prev.attachments.forEach(function (a) { patt.appendChild(el("span", "", a)); });
      q.appendChild(patt);
    }
    det.appendChild(q);
    read.appendChild(det);
  }
}

// ---- TABS, LINKS, KEYS (one delegated listener) ----
function showTab(name) {
  var panels = document.querySelectorAll("[data-view]");
  for (var i = 0; i < panels.length; i++) {
    panels[i].hidden = panels[i].getAttribute("data-view") !== name;
  }
  var tabs = document.querySelectorAll(".tab");
  for (var j = 0; j < tabs.length; j++) {
    tabs[j].setAttribute("aria-selected", tabs[j].getAttribute("data-tab") === name ? "true" : "false");
  }
  try { history.replaceState(null, "", "#" + name); } catch (err) {}
}

document.addEventListener("click", function (e) {
  var t = e.target.closest("[data-act]");
  if (!t) return;
  var act = t.getAttribute("data-act");
  if (act === "tab") showTab(t.getAttribute("data-tab"));
  else if (act === "post") showPost(Number(t.getAttribute("data-i")));
  else if (act === "poem") showPoem(Number(t.getAttribute("data-i")));
  else if (act === "folder") showFolder(t.getAttribute("data-f"));
  else if (act === "mail") showMail(Number(t.getAttribute("data-i")));
  else if (act === "subscribe") {
    var on = t.getAttribute("aria-pressed") !== "true";
    t.setAttribute("aria-pressed", on ? "true" : "false");
    t.textContent = on ? "Subscribed" : "Subscribe";
  }
});

document.addEventListener("keydown", function (e) {
  if (!document.querySelector('[data-view="essay"]').hidden) {
    if (e.key === "ArrowRight") showPoem(poemIx + 1);
    if (e.key === "ArrowLeft") showPoem(poemIx - 1);
  }
});

// Sign-up. Uses SIGNUP_ENDPOINT when it is set (for the published site). Otherwise,
// or if the endpoint cannot be reached, writes to the Claude artifact's database.
async function registerInterest(email) {
  if (SIGNUP_ENDPOINT) {
    try {
      var r = await fetch(SIGNUP_ENDPOINT, {
        method: "POST",
        headers: { "Accept": "application/json", "Content-Type": "application/json" },
        body: JSON.stringify({ email: email, source: "The Good Friend" })
      });
      if (r.ok) return "Thanks. You're on the list.";
      return "Something went wrong. Please try again.";
    } catch (err) { /* fall through to the artifact database */ }
  }
  var db = null;
  try {
    db = window.claude && window.claude.use ? await window.claude.use("db") : null;
  } catch (err) { db = null; }
  if (!db) return "Sign-up isn't available in this view. Please try again later.";
  try {
    await db.collection("signups").add({ email: email, at: new Date().toISOString() });
    return "Thanks. You're on the list.";
  } catch (err) {
    if (err && err.code === "resource_exhausted") return "Too many attempts. Try again in a moment.";
    if (err && err.code === "quota_exceeded") return "The list is full at the moment.";
    return "Something went wrong. Please try again.";
  }
}

document.addEventListener("submit", async function (e) {
  if (!e.target.matches("#signup-form")) return;
  e.preventDefault();
  var v = document.getElementById("signup-email").value.trim();
  var msg = document.getElementById("signup-msg");
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) {
    msg.textContent = "Enter a valid email address.";
    return;
  }
  msg.textContent = "Registering...";
  msg.textContent = await registerInterest(v);
});

