<style>
/* Layout: one shell, four surfaces (group chat, feed, blog, email), switched by tab.
   Palette: warm charcoal ground, parchment ink, one muted gold accent.
   Each surface keeps its own world: WhatsApp, Instagram, cream paper, Outlook. */
:root {
  color-scheme: dark;
  --bg: #15130f;
  --panel: #1e1b16;
  --ink: #ece4d2;
  --mute: #9d9583;
  --line: #3a3429;
  --gold: #c8a45e;
  --rust: #a4593f;
  --sage: #8ea291;
  --slate: #7f8ea0;
  --wa-bg: #0b141a;
  --wa-in: #1f2c34;
  --wa-out: #005c4b;
  --paper: #f1e5c9;
  --paper-ink: #2b2016;
  --paper-mute: #7d6a4f;
  --paper-rule: #cdb98e;
  --paper-accent: #9c3d2e;
  --serif: "Newsreader", Georgia, serif;
  --sans: "DM Sans", system-ui, sans-serif;
  --mono: "DM Mono", ui-monospace, monospace;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: radial-gradient(900px 480px at 50% -200px, #2a241b, transparent 70%), var(--bg);
  background-attachment: fixed;
  color: var(--ink);
  font: 400 15px/1.55 var(--sans);
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-block: 28px 48px;
  min-height: 100vh;
}
button { font: inherit; color: inherit; cursor: pointer; }
:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
[hidden] { display: none !important; }

.masthead { max-width: 560px; margin: 0 auto 24px; text-align: center; padding-top: 6px; }
.title { font: 400 italic clamp(40px, 11vw, 64px)/1.05 var(--serif); letter-spacing: .005em; margin: 0; color: var(--ink); text-wrap: balance; }
.title::after { content: ""; display: block; width: 48px; height: 1px; margin: 16px auto 0; background: var(--gold); }

.tabs { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; max-width: 560px; margin: 0 auto 26px; }
.tab {
  --c: var(--mute);
  background: transparent; border: 1px solid var(--line); border-radius: 999px;
  padding: 8px 16px; font: 500 11px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase;
  color: var(--mute); transition: background .2s, color .2s, border-color .2s;
}
.tab:hover { border-color: var(--c); color: var(--ink); }
.tab[data-tab="chat"] { --c: var(--sage); }
.tab[data-tab="feed"] { --c: var(--rust); }
.tab[data-tab="essay"] { --c: var(--gold); }
.tab[data-tab="mail"] { --c: var(--slate); }
.tab[aria-selected="true"] { background: var(--c); border-color: var(--c); color: #15130f; }

.view { max-width: 560px; margin: 0 auto; }

/* Group chat */
.chat { background: var(--wa-bg); border-radius: 14px; padding: 14px 12px; display: flex; flex-direction: column; gap: 6px; min-width: 0; box-shadow: 0 20px 40px -26px rgba(0,0,0,.8); }
.chat-head { display: flex; align-items: center; gap: 10px; padding: 0 2px 10px; border-bottom: 1px solid #1f2a31; margin-bottom: 6px; }
.chat-avatar { width: 36px; height: 36px; border-radius: 50%; background: #25d366; color: #0b141a; display: grid; place-items: center; font: 500 13px var(--mono); flex: none; }
.chat-title { font-weight: 500; font-size: 15px; }
.chat-sub { font-size: 12px; color: #8696a0; }
.msg { max-width: 82%; padding: 7px 10px 5px; border-radius: 9px; background: var(--wa-in); font-size: 14px; line-height: 1.4; min-width: 0; overflow-wrap: anywhere; }
.msg.r { align-self: flex-end; background: var(--wa-out); }
.msg .who { display: block; font: 500 12px var(--sans); color: #53bdeb; margin-bottom: 2px; }
.msg .time { display: block; text-align: right; font: 400 10px var(--mono); color: #8696a0; margin-top: 2px; }
.msg .rx { display: inline-flex; gap: 6px; margin: 4px 0 0; padding: 1px 6px; border-radius: 999px; background: #0b141a; font-size: 12px; }
.compose { display: flex; align-items: center; gap: 8px; margin-top: 10px; padding: 8px 8px 8px 14px; border-radius: 999px; background: #1f2c34; font-size: 14px; min-width: 0; }
.compose .draft { flex: 1; min-width: 0; color: #e9edef; overflow-wrap: anywhere; }
.compose .send { flex: none; width: 34px; height: 34px; border-radius: 50%; background: #00a884; opacity: .35; }

/* Instagram (dark mode, profile page) */
.insta { background: #000; color: #f5f5f5; border: 1px solid #262626; border-radius: 12px; overflow: hidden; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
.ig-bar { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid #262626; }
.ig-user { font: 700 17px/1 var(--sans); display: flex; align-items: center; gap: 6px; }
.ig-user .chev { font-size: 11px; color: #a8a8a8; }
.ig-bar .ig-icons { color: #f5f5f5; font-size: 20px; letter-spacing: 14px; }
.ig-top { display: flex; align-items: center; gap: 22px; padding: 18px 16px 10px; }
.ig-ring { width: 86px; height: 86px; border-radius: 50%; padding: 3px; background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888); flex: none; }
.ig-ring span { display: grid; place-items: center; width: 100%; height: 100%; border-radius: 50%; background: #000; border: 3px solid #000; font: 700 24px var(--sans); color: #f5f5f5; }
.ig-stats { display: flex; flex: 1; justify-content: space-around; text-align: center; min-width: 0; }
.ig-stats div { font-size: 13px; color: #f5f5f5; }
.ig-stats b { display: block; font-size: 16px; font-weight: 700; }
.ig-name { padding: 0 16px; font: 600 14px/1.3 var(--sans); }
.ig-name .sub { display: block; font-weight: 400; color: #a8a8a8; font-size: 13px; }
.ig-btns { display: flex; gap: 6px; padding: 12px 16px 16px; }
.ig-btns button { flex: 1; background: #262626; border: 0; border-radius: 8px; padding: 7px 0; font: 600 13px var(--sans); color: #f5f5f5; }
.ig-tabs { display: flex; border-top: 1px solid #262626; }
.ig-tabs span { flex: 1; text-align: center; padding: 12px 0; font: 600 12px var(--sans); letter-spacing: .08em; color: #f5f5f5; border-top: 1px solid #f5f5f5; margin-top: -1px; }
.ig-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; }
.ig-tile { aspect-ratio: 1; border: 0; padding: 0; min-width: 0; overflow: hidden; background: #111; display: block; }
.ig-tile img { display: block; width: 100%; height: 100%; object-fit: cover; }
.ig-tile[aria-pressed="true"] { opacity: .65; }
.ig-post { border-top: 1px solid #262626; margin-top: 3px; }
.ig-post-head { display: flex; align-items: center; gap: 10px; padding: 10px 12px; }
.ig-post-head .mini { width: 32px; height: 32px; border-radius: 50%; padding: 2px; background: linear-gradient(45deg, #f09433, #dc2743, #bc1888); flex: none; }
.ig-post-head .mini span { display: grid; place-items: center; width: 100%; height: 100%; border-radius: 50%; background: #000; font: 700 11px var(--sans); }
.ig-post-head b { font-size: 13px; }
.ig-post img { display: block; width: 100%; height: auto; max-height: 70vh; object-fit: contain; background: #000; }
.ig-actions { display: flex; align-items: center; gap: 14px; padding: 10px 12px 4px; }
.ig-actions svg { width: 24px; height: 24px; fill: none; stroke: #f5f5f5; stroke-width: 2; }
.ig-body { padding: 4px 12px 14px; font-size: 14px; }
.ig-body .likes { font-weight: 600; margin-bottom: 6px; }
.ig-body .cap { margin: 0; }
.ig-body .cap b { margin-right: 6px; }

/* Blog: a poetry page on creamy paper */
.essay { background: var(--paper); color: var(--paper-ink); border-radius: 4px; padding: 26px 24px 32px; min-width: 0; box-shadow: 0 22px 40px -24px rgba(0,0,0,.75); }
.paper-head { text-align: center; padding-bottom: 14px; border-bottom: 3px double var(--paper-rule); }
.paper-head .pub { font: 400 italic clamp(40px, 11vw, 58px)/1 var(--serif); color: var(--paper-ink); }
.paper-head .by { font: 400 12px var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--paper-mute); margin-top: 10px; }

.pager { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin: 18px 0 4px; }
.pager button {
  background: none; border: 1px solid var(--paper-rule); border-radius: 999px;
  padding: 6px 14px 6px 8px; display: inline-flex; align-items: center; gap: 8px;
  font: 500 11px/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--paper-mute);
}
.pager .num { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--paper-rule); color: var(--paper-ink); font: 400 italic 14px/1 var(--serif); }
.pager button[aria-selected="true"] { background: var(--paper-ink); border-color: var(--paper-ink); color: var(--paper); }
.pager button[aria-selected="true"] .num { background: var(--paper); color: var(--paper-ink); }

.page { padding-top: 14px; }
.page.turn { animation: pageturn .5s cubic-bezier(.2,.7,.2,1) both; }
@keyframes pageturn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
.folio { font: 500 11px var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--paper-mute); }
.ptitle { font: 400 clamp(30px, 8vw, 42px)/1.05 var(--serif); letter-spacing: .01em; margin: 8px 0 14px; text-wrap: balance; color: var(--paper-ink); }
.prule { height: 1px; background: var(--paper-rule); margin-bottom: 22px; }

.stanza { font: 400 18px/1.75 var(--serif); margin: 0; white-space: pre-line; overflow-wrap: anywhere; }
.stanza .dc { float: left; font: 400 64px/0.82 var(--serif); color: var(--paper-accent); margin: 6px 10px 0 0; }
.sep { text-align: center; color: var(--paper-mute); font-size: 12px; margin: 22px 0; letter-spacing: .8em; }

.subscribe { display: inline-flex; margin-top: 26px; background: var(--paper-ink); color: var(--paper); border: 0; border-radius: 999px; padding: 10px 20px; font: 500 13px var(--sans); }
.subscribe[aria-pressed="true"] { background: transparent; color: var(--paper-ink); border: 1px solid var(--paper-ink); }
@media (prefers-reduced-motion: reduce) { .page.turn { animation: none; } }

/* Outlook-style email client */
.ol { background: #ffffff; color: #242424; border-radius: 10px; overflow: hidden; box-shadow: 0 24px 48px -28px rgba(0,0,0,.8); font-family: var(--sans); }
.ol-top { display: flex; align-items: center; gap: 12px; padding: 10px 14px; background: #0f6cbd; color: #fff; }
.ol-logo { font: 600 14px var(--sans); white-space: nowrap; }
.ol-search { flex: 1; min-width: 0; background: rgba(255,255,255,.2); border-radius: 6px; padding: 6px 10px; font-size: 13px; color: #e3eefa; }
.ol-av { width: 28px; height: 28px; border-radius: 50%; background: #fff; color: #0f6cbd; display: grid; place-items: center; font: 600 11px var(--sans); flex: none; }
.ol-folders { display: flex; gap: 6px; padding: 8px 12px; border-bottom: 1px solid #e1e1e1; overflow-x: auto; }
.ol-folder { font: 500 12px var(--sans); padding: 5px 10px; border-radius: 6px; border: 0; background: none; color: #616161; white-space: nowrap; }
.ol-folder:hover { background: #f3f3f3; }
.ol-folder[aria-pressed="true"] { background: #e6f0fa; color: #0f6cbd; font-weight: 600; }
.ol-folder .ct { color: #0f6cbd; font-weight: 700; margin-left: 4px; }
.ol-list { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid #e1e1e1; }
.ol-item { display: grid; grid-template-columns: 38px 1fr; gap: 10px; width: 100%; text-align: left; background: #fff; border: 0; border-bottom: 1px solid #f0f0f0; padding: 12px 14px; color: inherit; }
.ol-item:hover { background: #f5f9fd; }
.ol-item[aria-selected="true"] { background: #eef5fc; box-shadow: inset 3px 0 0 #0f6cbd; }
.ol-item .av { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; color: #fff; font: 600 13px var(--sans); }
.ol-item .row1 { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 13px; }
.ol-item .from { font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ol-item .date { font-size: 11px; color: #616161; white-space: nowrap; }
.ol-item .subj { font-size: 13px; margin-top: 2px; }
.ol-item .prev { font-size: 12px; color: #616161; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; }
.ol-item.unread .from, .ol-item.unread .subj { font-weight: 700; }
.ol-item .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #0f6cbd; margin-right: 6px; vertical-align: middle; }
.ol-item .draft-tag { color: #a4262c; font-weight: 600; }
.ol-empty { padding: 28px 14px; font-size: 13px; color: #616161; text-align: center; margin: 0; }
.ol-read { padding: 18px 18px 22px; min-width: 0; }
.ol-read .subject { font: 600 19px/1.25 var(--sans); margin: 0 0 14px; overflow-wrap: anywhere; }
.hdr { display: flex; gap: 12px; align-items: flex-start; margin-bottom: 16px; }
.hdr .av { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; color: #fff; font: 600 13px var(--sans); flex: none; }
.hdr .who { font-weight: 600; font-size: 14px; }
.hdr .meta { font-size: 12px; color: #616161; line-height: 1.6; overflow-wrap: anywhere; }
.ol-read p { font: 400 14px/1.6 var(--sans); margin: 0 0 12px; overflow-wrap: anywhere; }
.ol-att { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; padding-top: 14px; border-top: 1px solid #e1e1e1; }
.ol-att span { font: 500 12px var(--sans); padding: 7px 10px; border: 1px solid #d1d1d1; border-radius: 6px; background: #fafafa; color: #242424; max-width: 100%; overflow-wrap: anywhere; }
.ol-att span::before { content: "\1F4CE"; margin-right: 6px; }
details.earlier { margin-top: 18px; }
details.earlier summary { cursor: pointer; color: #0f6cbd; font: 600 13px var(--sans); padding: 8px 0; }
details.earlier .quoted { border-left: 3px solid #c7d9ee; padding-left: 14px; margin-top: 8px; }

/* Register interest */
.signup { max-width: 560px; margin: 36px auto 0; padding: 24px; border: 1px solid var(--line); border-radius: 14px; background: var(--panel); display: grid; gap: 14px; }
.signup h2 { margin: 0; font: 400 italic 26px/1.15 var(--serif); color: var(--ink); }
.signup p { margin: 6px 0 0; color: var(--mute); font-size: 14px; }
.signup-row { display: flex; gap: 8px; flex-wrap: wrap; }
.signup input { flex: 1 1 200px; min-width: 0; padding: 12px 16px; border-radius: 999px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); font: inherit; }
.signup input:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
.signup button { padding: 12px 22px; border-radius: 999px; border: 0; background: var(--gold); color: #15130f; font: 600 13px var(--sans); letter-spacing: .02em; }
.signup-msg { min-height: 1.4em; margin: 10px 0 0; font: 400 12px/1.4 var(--mono); color: var(--mute); }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>

